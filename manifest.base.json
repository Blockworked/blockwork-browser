{
  "name": "Blockwork",
  "short_name": "Blockwork",
  "description": "Lets Blockwork macros click, type and read on web pages directly, by element instead of by screen picture.",
  "version": "0.1.0",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["engine.js"], "all_frames": true, "match_about_blank": true, "run_at": "document_idle" }
  ]
}
